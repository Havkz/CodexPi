#!/home/raspberry/CodexPi/.venv/bin/python
import argparse
import asyncio
import json
from pathlib import Path
import shlex
import sys

from aiohttp import ClientSession, UnixConnector

ROOT = Path('/home/raspberry/CodexPi')


async def main():
    parser = argparse.ArgumentParser(description='Local infrastructure tool for the single Codex worker')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('windows-status')
    job = sub.add_parser('windows-job')
    job.add_argument('--commit', required=True)
    job.add_argument('--reason', required=True)
    job.add_argument('--timeout', type=int, default=900)
    job.add_argument('--artifact', action='append', default=[])
    job.add_argument('argv', nargs=argparse.REMAINDER)
    deploy = sub.add_parser('deploy-pi', help='Schedule explicit 24/7 delivery at verified native completion')
    deploy.add_argument('--goal-requires-24x7', action='store_true', required=True)
    deploy.add_argument('--reason', required=True)
    deploy.add_argument('--health-command', required=True, help='Read-only health check argv, parsed without a shell')
    deploy.add_argument('argv', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    async with ClientSession(connector=UnixConnector(path=str(ROOT / 'state/local.sock'))) as client:
        if args.command == 'windows-status':
            async with client.get('http://localhost/windows-status') as response:
                print(await response.text())
                return
        directory = Path.cwd().resolve()
        while not (directory / '.codexpi/project-id').exists():
            if directory == directory.parent:
                raise SystemExit('Run the tool from a managed CodexPi project')
            directory = directory.parent
        argv = args.argv[1:] if args.argv[:1] == ['--'] else args.argv
        if args.command == 'deploy-pi':
            body = {'project_id': (directory / '.codexpi/project-id').read_text(),
                    'goal_requires_24x7': args.goal_requires_24x7, 'reason': args.reason,
                    'check': shlex.split(args.health_command), 'argv': argv}
            async with client.post('http://localhost/deployment/pi', json=body) as response:
                result = await response.json()
                if response.status != 200:
                    raise SystemExit(result.get('error', 'Deployment request failed'))
                print(json.dumps(result))
                return
        body = {'project_id': (directory / '.codexpi/project-id').read_text(),
                'commit': args.commit, 'reason': args.reason, 'timeout': args.timeout,
                'artifacts': args.artifact, 'argv': argv}
        async with client.post('http://localhost/jobs', json=body) as response:
            result = await response.json()
            if response.status != 200:
                raise SystemExit(result.get('error', 'Windows job failed'))
        while True:
            async with client.get('http://localhost/jobs/' + result['job_id']) as response:
                state = await response.json()
            if state['status'] == 'finished':
                print(json.dumps(state['result'], indent=2))
                raise SystemExit(0 if state['result']['exit_code'] == 0 else 1)
            if state['status'] == 'unknown':
                raise SystemExit('Worker disconnected during execution; result unknown. Do not blindly repeat side effects.')
            await asyncio.sleep(2)


asyncio.run(main())
