[Unit]
Description=CodexPi single native Codex runtime
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/raspberry/CodexPi
Environment=PATH=/home/raspberry/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PONYTAIL_DEFAULT_MODE=full
UMask=0077
ExecStart=/home/raspberry/.local/bin/codex app-server --listen unix:///home/raspberry/CodexPi/state/native.sock --disable multi_agent -c thread_unload_delay_secs=5
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
