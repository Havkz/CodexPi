[Unit]
Description=CodexPi controller, dashboard, Discord and scheduler
After=network-online.target codexpi-native.service codexpi-unsnooze.service
Wants=network-online.target codexpi-native.service codexpi-unsnooze.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/raspberry/CodexPi
Environment=PATH=/home/raspberry/CodexPi/bin:/home/raspberry/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=UNSNOOZE_AUTO_RESUME=false
UMask=0077
ExecStart=/home/raspberry/CodexPi/.venv/bin/python -m app.main
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
